<?xml version="1.0" encoding="UTF-8"?>
<Algorithm_Parameters>

    <Algorithm Type="Basic_Scheme">                     <!-- "Default" (Basic_Scheme) ou "Basic_Scheme" -->
        <Convergence_Criterion Value="1e-4"/>        <!-- "Default" (1e-4) ou valeur réelle positive <1e-3 -->
        <Convergence_Acceleration Value="true"/>        <!-- "True" ou "False" -->
        <Nitermax Value="1000" />
        <Substepping Nitermax2="100" Geom_ratio="1." Nsub="10" Depth="3" />  <!-- Nitermax2  : initial number of iterations before supstepping
                                                                                  Geom_ratio : after each substepping Nitermax2 = Geom_ratio * Nitermax2
                                                                                               prefer Geom_ratio = 1
                                                                                  Nsub  : number of stubsteps when activating a new substepping
                                                                                  Depth : maximum number of impricated substeppings
                                                                                          if Depth = 4 and Nsub=10, the finest substep 
                                                                                             is (1/10^3) of the initial step
                                                                              -->
    </Algorithm>

    <Mechanics>    
        <Filter Type="Default"/>                            <!-- "Default" (hexa) ou "no_filter" ou "hexa" ou "octa" -->
        <Small_Perturbations Value="false"/>                 <!-- "True" ou "False" --> 
    </Mechanics>
</Algorithm_Parameters>

